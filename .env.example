# Pooled connection for the app runtime (Neon: the "-pooler" host).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection for migrations (Neon: same host without "-pooler").
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Optional, server-only. Raises GitHub API limits. Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=""
